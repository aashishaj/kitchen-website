---
import { nav } from '../content/site';
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="#top" aria-label="kitchen, back to top">
      <span class="brand-tile" aria-hidden="true">&gt;_</span>
      <span class="brand-word">kitchen</span>
    </a>
    <nav aria-label="main">
      <ul class="nav-links">
        {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="nav-toggles">
      <button class="pill" type="button" data-theme-toggle aria-label="switch light and dark theme">
        theme: <span data-theme-label>light</span> <span aria-hidden="true">◐</span>
      </button>
      <button class="pill mode" type="button" data-mode-toggle aria-label="switch between story and tech copy">
        <span data-mode-opt="story">story</span> / <span data-mode-opt="tech">tech</span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: background-color .4s ease, box-shadow .4s ease;
  }
  .nav:global(.scrolled) {
    background: var(--paper);
    box-shadow: 0 1px 0 var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 76px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-right: auto;
  }
  .brand-tile {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: #FAEFE0;
    color: #2F2F2F;
    box-shadow: inset 0 0 0 1.5px #2F2F2F;
    font: 400 15px var(--mono);
  }
  .brand-word { font: 400 34px/1 var(--serif); letter-spacing: -.02em; }
  .nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    font: 400 14px var(--mono);
    text-decoration: none;
  }
  .nav-links a:hover { color: var(--coral); }
  .nav-toggles { display: flex; gap: 10px; }
  .pill {
    min-height: 36px;
    padding: 0 14px;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: 400 13px var(--mono);
    cursor: pointer;
    white-space: nowrap;
  }
  .mode [data-mode-opt] { opacity: .5; }
  .mode :global(.on) { opacity: 1; text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 900px) {
    .nav-links { display: none; }
  }
  @media (max-width: 480px) {
    .nav-inner { gap: 10px; height: 64px; }
    .brand-word { font-size: 28px; }
    .brand-tile { width: 32px; height: 32px; font-size: 13px; }
    .pill { padding: 0 10px; font-size: 12px; }
    .pill[data-theme-toggle] { font-size: 0; padding: 0 12px; }
    .pill[data-theme-toggle] span[aria-hidden] { font-size: 16px; }
  }
</style>
