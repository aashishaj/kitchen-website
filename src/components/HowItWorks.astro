---
import { howItWorks } from '../content/site';
import Title from './Title.astro';
import Copy from './Copy.astro';
import BinaryArt from './BinaryArt.astro';
---
<section class="section how" id="how-it-works" aria-labelledby="how-title">
  <div class="wrap">
    <p class="label">{howItWorks.label}</p>
    <Title id="how-title" story={howItWorks.story.title} tech={howItWorks.tech.title} />
    <ol class="steps">
      {howItWorks.steps.map((s) => (
        <li class="step">
          <div class="step-art"><BinaryArt name={s.art} label={s.alt} /></div>
          <p class="label step-n">{s.n}</p>
          <h3><Copy story={s.story.title} tech={s.tech.title} /></h3>
          <p><Copy story={s.story.body} tech={s.tech.body} /></p>
        </li>
      ))}
    </ol>
    <pre class="terminal" data-tech aria-label="example terminal session"><code>{howItWorks.terminal}</code></pre>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: clamp(56px, 8vw, 96px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 64px);
  }
  .step-art { display: flex; align-items: flex-end; min-height: 340px; }
  .step :global(.art) { max-width: 300px; margin-bottom: 8px; }
  .step-n { margin: 8px 0 10px; }
  .step h3 { margin-bottom: 10px; }
  .step p:last-child { margin: 0; max-width: 24em; }
  .terminal {
    margin: 64px 0 0;
    padding: 20px 24px;
    border: 1.5px solid var(--ink);
    border-radius: 10px;
    background: var(--cloud);
    font: 400 14px/1.8 var(--mono);
    overflow-x: auto;
  }
  @media (max-width: 860px) {
    .steps { grid-template-columns: 1fr; gap: 56px; }
    .step :global(.art) { max-width: 260px; }
    .step-art { min-height: 0; }
  }
</style>
