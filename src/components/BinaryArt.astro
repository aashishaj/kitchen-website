---
// A food or kitchen image drawn in flickering 0s and 1s. `name` is a file in
// public/art (made by scripts/prepare-art.py).
interface Props { name: string; label: string; steam?: boolean; status?: boolean; class?: string }
const { name, label, steam = false, status = true, class: cls = '' } = Astro.props;
---
<div class:list={['art', cls]} data-src={`/art/${name}.json`} data-steam={steam ? '' : undefined}>
  <canvas role="img" aria-label={label}></canvas>
  {status && <p class="art-status" aria-hidden="true"></p>}
</div>
