---
import { problem } from '../content/site';
import Title from './Title.astro';
import Copy from './Copy.astro';
---
<section class="section" aria-labelledby="problem-title">
  <div class="wrap narrow">
    <p class="label">{problem.label}</p>
    <Title id="problem-title" story={problem.story.title} tech={problem.tech.title} />
    <p class="lede"><Copy story={problem.story.body} tech={problem.tech.body} /></p>
    <pre class="joke" aria-label="a terminal error: missing .env"><code>{problem.joke}</code></pre>
  </div>
</section>

<style>
  .narrow { max-width: calc(980px + var(--gutter) * 2); }
  .joke {
    margin: 40px 0 0;
    font: 400 13px/1.7 var(--mono);
    color: var(--ink-soft);
    white-space: pre-wrap;
  }
  .joke::first-line { color: var(--ink); }
</style>
