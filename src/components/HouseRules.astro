---
import { houseRules } from '../content/site';
import Title from './Title.astro';
import Copy from './Copy.astro';
import BinaryArt from './BinaryArt.astro';
---
<section class="section rules" id="house-rules" aria-labelledby="rules-title">
  <div class="wrap rules-grid">
    <div>
      <p class="label">{houseRules.label}</p>
      <Title id="rules-title" story={houseRules.story.title} tech={houseRules.tech.title} />
      <p class="lede"><Copy story={houseRules.story.body} tech={houseRules.tech.body} /></p>
      <div class="receipt" aria-label="receipt">
        <p class="r-head">kitchen · receipt</p>
        <p class="r-sep" aria-hidden="true">- - - - - - - - - - - - - - -</p>
        {houseRules.receipt.map(([k, v]) => <p class="r-row"><span>{k}</span><span>{v}</span></p>)}
        <p class="r-sep" aria-hidden="true">- - - - - - - - - - - - - - -</p>
        <p class="r-ok">served at home ✓</p>
      </div>
    </div>
    <div class="rules-art"><BinaryArt name="jar" label={houseRules.art} /></div>
  </div>
</section>

<style>
  .rules-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .rules-art { max-width: 340px; justify-self: center; width: 100%; }
  .receipt {
    margin-top: 40px;
    max-width: 320px;
    padding: 20px 22px;
    background: var(--cloud);
    font: 400 13px/1.6 var(--mono);
    transform: rotate(-1.2deg);
    transition: background-color .8s ease;
  }
  .receipt p { margin: 0; }
  .r-head { text-align: center; }
  .r-sep { color: var(--ink-soft); overflow: hidden; white-space: nowrap; }
  .r-row { display: flex; justify-content: space-between; }
  .r-ok { color: var(--ok); text-align: center; }
  @media (max-width: 860px) {
    .rules-grid { grid-template-columns: 1fr; }
    .rules-art { max-width: 260px; justify-self: start; }
  }
</style>
