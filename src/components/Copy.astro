---
// Renders the story and tech versions of a piece of copy side by side;
// CSS shows the one that matches the story/tech toggle.
interface Props { story: string; tech?: string; as?: string; class?: string }
const { story, tech, as: Tag = 'span', class: cls } = Astro.props;
---
{tech && tech !== story ? (
  <>
    <Tag class={cls} data-story>{story}</Tag>
    <Tag class={cls} data-tech>{tech}</Tag>
  </>
) : (
  <Tag class={cls}>{story}</Tag>
)}
