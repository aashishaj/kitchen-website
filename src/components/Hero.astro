---
import { hero, links, statusBar } from '../content/site';
import Title from './Title.astro';
import Copy from './Copy.astro';
import BinaryArt from './BinaryArt.astro';
import Landscape from './Landscape.astro';
---
<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="label">{hero.label}</p>
      <Title level={1} story={hero.story.title} tech={hero.tech.title} cursor />
      <p class="lede"><Copy story={hero.story.body} tech={hero.tech.body} /></p>
      <div class="ctas">
        <a class="btn" href="#reserve"><span class="prompt">$</span> {hero.cta.replace(/^\$ /, '')}</a>
        <a class="link" href={links.bookDemo} data-demo="hero">{hero.demo}</a>
      </div>
    </div>
    <figure class="window">
      <figcaption class="window-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>~/kitchen/mug.bin</span>
        <span class="chip" data-status-chip>brewing…</span>
      </figcaption>
      <BinaryArt name="mug" label={hero.art} steam status={false} />
    </figure>
  </div>
  <div class="hero-land"><Landscape variant="hero" /></div>
  <div class="statusbar" aria-label="status">
    <span class="mode-chip">{statusBar.mode}</span>
    <span>{statusBar.branch}</span>
    <span class="sb-mid"><span data-status-chip>brewing…</span> {statusBar.middle}</span>
    <span class="sb-right">{statusBar.right}</span>
  </div>
</section>

<style>
  .hero {
    background: var(--sky);
    transition: background-color .8s ease;
    padding-top: clamp(104px, 13vh, 150px);
    overflow: hidden;
    min-height: min(100svh, 1000px);
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .hero > .wrap { flex: 1; padding-bottom: clamp(200px, 24vw, 340px); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, .8fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .hero-copy :global(.label) { color: inherit; opacity: .75; }
  .lede { max-width: 30em; }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 36px;
  }
  .window {
    margin: 0;
    max-width: 400px;
    justify-self: end;
    width: 100%;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 10px;
    padding: 0 22px 22px;
    transition: background-color .8s ease;
  }
  .window-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 -22px 18px;
    padding: 10px 14px;
    border-bottom: 1.5px solid var(--ink);
    font: 400 12px var(--mono);
  }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid var(--ink); }
  .chip {
    margin-left: auto;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--coral);
    color: #FAEFE0;
  }
  .hero-land { position: absolute; left: 0; right: 0; bottom: 28px; z-index: 1; }
  .hero-land :global(svg) { height: clamp(240px, 32vw, 460px); }
  .statusbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 6px var(--gutter);
    background: var(--cloud);
    color: var(--ink);
    font: 400 12px var(--mono);
    white-space: nowrap;
    overflow: hidden;
    transition: background-color .8s ease;
  }
  .mode-chip { background: var(--coral); color: #FAEFE0; padding: 1px 8px; }
  .sb-mid { margin: 0 auto; }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .window { max-width: 360px; justify-self: start; }
    .sb-right { display: none; }
  }
  @media (max-width: 480px) {
    .sb-mid { margin-right: 0; }
  }
</style>
