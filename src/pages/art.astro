---
// Test page: every binary art piece, light and dark side by side.
import Base from '../layouts/Base.astro';
import BinaryArt from '../components/BinaryArt.astro';
const pieces = ['mug', 'fruit-bowl', 'board', 'dish', 'table', 'jar', 'bell', 'empty-plate'];
---
<Base title="binary art test · kitchen">
  <main class="wrap test">
    <p class="label">// binary art · test page (not linked from the site)</p>
    {pieces.map((p) => (
      <section class="pair">
        <h2 class="label">{p}</h2>
        <div class="cols">
          <div class="pane light"><BinaryArt name={p} label={`${p} in binary, light`} steam={p === 'mug'} /></div>
          <div class="pane dark"><BinaryArt name={p} label={`${p} in binary, dark`} steam={p === 'mug'} /></div>
        </div>
      </section>
    ))}
  </main>
</Base>

<style>
  .test { padding: 48px var(--gutter); }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .pane { padding: 24px; border-radius: 10px; }
  /* Each pane pins its own theme tokens. */
  .light { background: #FAEFE0; --art-ink: #2F2F2F; --art-sky: #6FA3DC; --art-field: #9DAF6E; --art-coral: #EF7A4F; --ink-soft: #6b665f; }
  .dark { background: #14213A; --art-ink: #F1E7D6; --art-sky: #6FA3DC; --art-field: #71864F; --art-coral: #C4603C; --ink-soft: #b9b1a3; }
  .pair { margin-bottom: 40px; }
</style>
