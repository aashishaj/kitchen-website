---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Menu from '../components/Menu.astro';
import Table from '../components/Table.astro';
import HouseRules from '../components/HouseRules.astro';
import ChefsTable from '../components/ChefsTable.astro';
import Reserve from '../components/Reserve.astro';
import Footer from '../components/Footer.astro';
import Landscape from '../components/Landscape.astro';
import Divider from '../components/Divider.astro';
---
<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Problem />
    <Divider text="end of problem" />
    <HowItWorks />
    <div class="break"><Landscape variant="break" /></div>
    <Menu />
    <Divider text="end of menu" />
    <Table />
    <Divider text="end of recipe" />
    <HouseRules />
    <Divider text="end of house rules" />
    <ChefsTable />
    <Reserve />
  </main>
  <Footer />
</Base>

<style>
  .break { background: var(--sky); padding-top: 80px; transition: background-color .8s ease; }
</style>
